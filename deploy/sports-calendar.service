# systemd unit for the Oracle VM. The deploy workflow installs this file to
# /etc/systemd/system/sports-calendar.service and runs daemon-reload before each restart,
# so edit it here, not on the VM.
[Unit]
Description=Sports Calendar Integration
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sports_calendar_integration
# --no-dev: the service needs neither pytest nor pandas (the dev and stats groups). The deploy installs the
# packages with `uv sync --locked --no-dev` before the restart, so this start only checks them.
ExecStart=/home/ubuntu/.local/bin/uv run --no-dev python main.py --queries queries.json
Restart=on-failure
RestartSec=60
# On stop, send SIGTERM only to the main process (uv), which passes it on to Python; Python then exits 0.
# With the default (control-group), Python and uv both get SIGTERM at the same moment, and uv then
# exits 143 even though Python exited 0, so systemd logged every deploy as a failure.
KillMode=mixed

[Install]
WantedBy=multi-user.target
