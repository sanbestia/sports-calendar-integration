# systemd unit for the Oracle VM: one fetch-and-sync run. deploy/sports-calendar.timer starts it every
# 15 minutes. The deploy workflow installs the unit files to /etc/systemd/system/ and runs daemon-reload,
# so edit them here, not on the VM.
[Unit]
Description=Sports Calendar Integration
After=network-online.target
Wants=network-online.target

[Service]
# oneshot: the unit is active while the run lasts, so the timer never starts a second run at the same time,
# and `systemctl start` returns only when the run ends (with an error when the run fails).
Type=oneshot
User=ubuntu
# User=ubuntu has passwordless sudo: NoNewPrivileges blocks sudo, and any setuid program, for the run.
# PrivateTmp gives the run its own /tmp, and ProtectSystem=full makes /usr, /boot and /etc read-only for it.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# The service's data (the two databases, queries.json, token.json and .env) lives in /var/lib/sports-calendar,
# outside the git checkout, so a git reset or git clean there cannot touch it. systemd creates the folder for
# User= at each start, keeps it when the unit stops, and sets its mode to 0700, because it holds secrets.
StateDirectory=sports-calendar
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sports-calendar
# --no-dev: the service needs neither pytest nor pandas (the dev and stats groups). The deploy installs the
# packages with `uv sync --locked --no-dev`, so this start only checks them.
# --project: the code is in the git checkout, and the working directory is the state folder.
# --locked: a uv.lock that does not match pyproject.toml stops the run; without it uv rewrites the lock by itself.
ExecStart=/home/ubuntu/.local/bin/uv run --locked --project /home/ubuntu/sports-calendar-integration --no-dev sports-calendar --queries queries.json
# A oneshot has no start timeout by default; a run that hangs would then block every later run. A normal run
# takes seconds.
TimeoutStartSec=5min
# On stop, send SIGTERM only to the main process (uv), which passes it on to Python; Python then exits 0.
# With the default (control-group), Python and uv both get SIGTERM at the same moment, and uv then
# exits 143 even though Python exited 0, so systemd logged every deploy as a failure.
KillMode=mixed
# No [Install] section and no Restart=: the timer starts each run, and a failed run is retried by the next one.
