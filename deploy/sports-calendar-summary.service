# systemd unit for the Oracle VM: log yesterday's totals (API calls, fetches, calendar changes).
# deploy/sports-calendar-summary.timer starts it each day.
[Unit]
Description=Sports Calendar Integration daily summary

[Service]
Type=oneshot
User=ubuntu
# the same state folder as the run (see sports-calendar.service)
StateDirectory=sports-calendar
StateDirectoryMode=0700
WorkingDirectory=/var/lib/sports-calendar
ExecStart=/home/ubuntu/.local/bin/uv run --project /home/ubuntu/sports_calendar_integration --no-dev sports-calendar-summary
TimeoutStartSec=5min
